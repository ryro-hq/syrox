mod std {
    mod pkg {
        value PackageId(str);
        value SourceUrl(str);
        value SourceDigest(str);
        value SourceLimit(int);
        value SourceDirectory(str);
        value InstalledEntry(str);
        value BuildTimeout(int);
        value OutputName(str);

        struct Dependency { package: PackageId; }
        struct Package { id: PackageId; dependencies: [Dependency]; }
        struct SourceRequest { url: SourceUrl; sha256: SourceDigest; maximum_bytes: SourceLimit; }
        struct Acquisition { package: PackageId; sources: [SourceRequest]; }
        struct AutotoolsBuild {
            package: PackageId;
            source_directory: SourceDirectory;
            entry: InstalledEntry;
            timeout_seconds: BuildTimeout;
        }
        struct GlibcBuild {
            package: PackageId;
            source_directory: SourceDirectory;
            entry: InstalledEntry;
            timeout_seconds: BuildTimeout;
        }
        // An output is a build input only when the build explicitly selects it.
        // The engine resolves its retained receipt; the Plan remains pure.
        struct BuildOutput { package: PackageId; output: OutputName; }
        struct BuildInputs { package: PackageId; selected: [BuildOutput]; }
        struct DefaultBuild { package: PackageId; }
        struct RuntimeLoader { package: PackageId; }
        struct RuntimeLibrary { package: PackageId; }
        struct Application {
            package: PackageId;
            loader: [RuntimeLoader];
            libraries: [RuntimeLibrary];
        }
        struct DefaultApplication { package: PackageId; }
    }
    outputs {
        type PackageId = pkg::PackageId;
        type SourceUrl = pkg::SourceUrl;
        type SourceDigest = pkg::SourceDigest;
        type SourceLimit = pkg::SourceLimit;
        type SourceDirectory = pkg::SourceDirectory;
        type InstalledEntry = pkg::InstalledEntry;
        type BuildTimeout = pkg::BuildTimeout;
        type OutputName = pkg::OutputName;
        type Dependency = pkg::Dependency;
        type Package = pkg::Package;
        type SourceRequest = pkg::SourceRequest;
        type Acquisition = pkg::Acquisition;
        type AutotoolsBuild = pkg::AutotoolsBuild;
        type GlibcBuild = pkg::GlibcBuild;
        type BuildOutput = pkg::BuildOutput;
        type BuildInputs = pkg::BuildInputs;
        type RuntimeLoader = pkg::RuntimeLoader;
        type RuntimeLibrary = pkg::RuntimeLibrary;
        type Application = pkg::Application;
        type DefaultBuild = pkg::DefaultBuild;
        type DefaultApplication = pkg::DefaultApplication;
    }
}
