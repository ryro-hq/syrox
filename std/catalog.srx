mod std::catalog {
    // A reusable set of typed factories. Looking up names never runs recipes.
    opaque struct PackageSet<R> {
        factories: OrderedMap<RecipeRef<R>>;
    }

    pub fn package_set<R>(
        entries: [MapEntry<fn() -> R>],
    ) -> Result<PackageSet<R>, MapKey> {
        let references = map(entries, fn(entry: MapEntry<fn() -> R>) -> MapEntry<RecipeRef<R>> {
            match entry { Entry(key, factory) => MapEntry::Entry(key, recipe_ref(factory)) }
        });
        package_set_refs(references)
    }

    // A catalog that also publishes named references must insert those very
    // references into the set, rather than memoizing each factory a second time.
    pub fn package_set_refs<R>(
        entries: [MapEntry<RecipeRef<R>>],
    ) -> Result<PackageSet<R>, MapKey> {
        match map_from_entries(entries) {
            Ok(factories) => Result::Ok(PackageSet<R> { factories = factories; }),
            Err(key) => Result::Err(key),
        }
    }

    pub fn package_names<R>(packages: PackageSet<R>) -> [MapKey] {
        map_keys(packages.factories)
    }

    pub fn package_factory<R>(packages: PackageSet<R>, key: MapKey) -> Option<fn() -> R> {
        match package_ref(packages, key) {
            Some(recipe) => Option::Some(recipe_factory(recipe)),
            None => Option::None(),
        }
    }

    pub fn package_ref<R>(packages: PackageSet<R>, key: MapKey) -> Option<RecipeRef<R>> {
        map_get(packages.factories, key)
    }

    pub fn package_get<R>(packages: PackageSet<R>, key: MapKey) -> Option<R> {
        match package_factory(packages, key) {
            Some(factory) => Option::Some(factory()),
            None => Option::None(),
        }
    }
}
